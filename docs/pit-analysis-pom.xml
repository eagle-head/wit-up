<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.commons</groupId>
  <artifactId>peekable-input-stream-measurement</artifactId>
  <version>1.0</version>
  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.5.2</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit-pioneer</groupId><artifactId>junit-pioneer</artifactId><version>0.3.0</version><scope>test</scope></dependency>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><version>3.0.0</version><scope>test</scope></dependency>
    <dependency><groupId>com.google.jimfs</groupId><artifactId>jimfs</artifactId><version>1.1</version><scope>test</scope></dependency>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.9</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${analysis.build}</directory>
    <sourceDirectory>${analysis.build}/empty-sources</sourceDirectory>
    <testSourceDirectory>${analysis.build}/empty-test-sources</testSourceDirectory>
    <outputDirectory>${analysis.checkout}/target/classes</outputDirectory>
    <testOutputDirectory>${analysis.checkout}/target/test-classes</testOutputDirectory>
    <plugins>
      <plugin>
        <groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>1.15.2</version>
        <dependencies>
          <dependency><groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>1.2.2</version></dependency>
        </dependencies>
        <configuration>
          <targetClasses><param>org.apache.commons.io.input.buffer.PeekableInputStream</param></targetClasses>
          <targetTests><param>org.apache.commons.io.*</param></targetTests>
          <mutationEngine>gregor</mutationEngine>
          <mutators><mutator>DEFAULTS</mutator></mutators>
          <threads>1</threads><timeoutFactor>1.25</timeoutFactor><timeoutConstant>3000</timeoutConstant>
          <outputFormats><param>XML</param></outputFormats>
          <reportsDirectory>${analysis.output}</reportsDirectory>
          <timestampedReports>false</timestampedReports>
          <exportLineCoverage>true</exportLineCoverage>
          <failWhenNoMutations>true</failWhenNoMutations>
          <projectBase>${analysis.checkout}</projectBase>
          <jvmArgs><jvmArg>-Xmx256m</jvmArg><jvmArg>-Djava.io.tmpdir=${analysis.temp}</jvmArg></jvmArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
